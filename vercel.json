{
  "version": 2,
  "functions": {
    "api/[...route].js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/web/responsive-rebuild/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/web/responsive-rebuild/$1"
    }
  ]
}
